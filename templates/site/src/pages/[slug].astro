---
import Base from '../layouts/Base.astro';
import tutorials from '../data/tutorials.json';

export function getStaticPaths() {
	const all = (tutorials as any).videos;
	return all.map((v: any, i: number) => ({
		params: { slug: v.id },
		props: { video: v, index: i, allVideos: all },
	}));
}

const { video, index, allVideos } = Astro.props as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Step = { n?: number; title?: string; text?: string; image?: string; context?: boolean };
const stepsDetail: Step[] = video.stepsDetail ?? [];

// Sequential display numbers for numbered entries (contexts don't count)
let counter = 0;
const numbered = stepsDetail.map((s) => ({ ...s, num: s.context ? undefined : ++counter }));

const poster = stepsDetail.find((s) => s.image)?.image;
const prev = index > 0 ? allVideos[index - 1] : null;
const next = index < allVideos.length - 1 ? allVideos[index + 1] : null;
---

<Base title={video.title}>
	<div class="video-page">
		<a href={`${base}/`} class="back-link">← All tutorials</a>

		<div class="video-player-wrap">
			<video controls class="video-player" poster={poster ? `${base}/videos/${poster}` : undefined}>
				<source src={`${base}/videos/${video.file}`} type="video/webm" />
			</video>
		</div>

		<div class="video-page-info">
			<h1 class="video-page-title">{video.title}</h1>
			{video.description && <p class="video-page-desc">{video.description}</p>}
			<div class="video-page-meta">
				<span class="video-duration">&#x1F553; {video.duration}</span>
			</div>
		</div>

		{numbered.length > 0 && (
			<section class="steps-guide">
				{numbered.map((s) => (
					s.context ? (
						<p class="step-context">{s.text}</p>
					) : (
						<div class="step-block">
							<div class="step-header">
								<span class="step-number">{s.num}</span>
								<div class="step-copy">
									{s.title && <h2 class="step-title">{s.title}</h2>}
									{s.text && <p class="step-text">{s.text}</p>}
								</div>
							</div>
							{s.image && (
								<img
									class="step-shot"
									src={`${base}/videos/${s.image}`}
									alt={s.title || `Step ${s.num}`}
									loading={s.num === 1 ? 'eager' : 'lazy'}
								/>
							)}
						</div>
					)
				))}
			</section>
		)}

		<nav class="video-nav-row" aria-label="navigation">
			<div class="nav-prev">
				{prev && (
					<a href={`${base}/${prev.id}`} class="nav-link nav-link-prev">
						<span class="nav-arrow">‹</span>
						<span class="nav-title">{prev.title}</span>
					</a>
				)}
			</div>
			<div class="nav-next">
				{next && (
					<a href={`${base}/${next.id}`} class="nav-link nav-link-next">
						<span class="nav-title">{next.title}</span>
						<span class="nav-arrow">›</span>
					</a>
				)}
			</div>
		</nav>
	</div>
</Base>

<style>
	.video-page {
		max-width: 900px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--color-primary);
	}

	.video-player-wrap {
		width: 100%;
		border-radius: var(--radius);
		overflow: hidden;
		background: #000;
		box-shadow: var(--shadow);
		margin-bottom: 1.5rem;
	}

	.video-player {
		width: 100%;
		display: block;
		max-height: 70vh;
	}

	.video-page-info {
		margin-bottom: 2rem;
	}

	.video-page-title {
		font-size: 1.75rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		line-height: 1.3;
	}

	.video-page-desc {
		color: var(--color-text-muted);
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 0.75rem;
	}

	.video-page-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.video-duration {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.steps-guide {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		margin-bottom: 3rem;
	}

	.step-context {
		color: var(--color-text-muted);
		font-style: italic;
		line-height: 1.6;
		border-inline-start: 3px solid var(--color-primary);
		padding-inline-start: 1rem;
		margin: 0;
	}

	.step-block {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.step-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.step-number {
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--color-primary);
		color: #fff;
		font-weight: 700;
		font-size: 0.95rem;
	}

	.step-copy {
		min-width: 0;
	}

	.step-title {
		font-size: 1.15rem;
		font-weight: 600;
		line-height: 1.4;
		margin: 0.2rem 0 0.35rem;
	}

	.step-text {
		color: var(--color-text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.step-shot {
		width: 100%;
		display: block;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow);
	}

	.video-nav-row {
		display: flex;
		justify-content: space-between;
		align-items: stretch;
		gap: 1rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
		margin-top: 1rem;
	}

	.nav-prev,
	.nav-next {
		flex: 1;
	}

	.nav-next {
		text-align: right;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--color-text);
		padding: 0.75rem 1rem;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: var(--color-bg-card);
		transition: all 0.2s;
		font-size: 0.9rem;
		max-width: 100%;
	}

	.nav-link:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		box-shadow: var(--shadow);
	}

	.nav-link-next {
		flex-direction: row-reverse;
	}

	.nav-arrow {
		font-size: 1.25rem;
		line-height: 1;
		flex-shrink: 0;
		color: var(--color-primary);
	}

	.nav-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 600px) {
		.video-page-title {
			font-size: 1.25rem;
		}

		.step-number {
			width: 1.6rem;
			height: 1.6rem;
			font-size: 0.85rem;
		}

		.nav-title {
			display: none;
		}
	}
</style>
