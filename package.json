{
  "name": "pw-tutorial-video",
  "version": "0.2.0",
  "description": "Turn Playwright end-to-end tests into professional narrated tutorial videos with TTS voice, animated cursor, step overlays, and ffmpeg post-processing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Youniwemi/pw-tutorial-video.git"
  },
  "homepage": "https://github.com/Youniwemi/pw-tutorial-video#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./slugify": {
      "types": "./dist/slugify.d.ts",
      "default": "./dist/slugify.js"
    },
    "./site": {
      "types": "./dist/site/types.d.ts",
      "default": "./dist/site/types.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "bin": {
    "pw-tutorial-video": "./dist/init.js",
    "tutorial-transcript": "./dist/bin/export-transcript.js"
  },
  "files": [
    "dist",
    "src/styles.css",
    "skills",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:video": "TUTORIAL_MODE=true playwright test",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/postinstall.js"
  },
  "keywords": [
    "playwright",
    "tutorial",
    "video",
    "e2e",
    "testing",
    "narration",
    "tts",
    "text-to-speech",
    "screen-recording",
    "documentation",
    "automated-docs",
    "how-to",
    "demo",
    "walkthrough"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "astro": "^5.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.2.0",
    "@types/sharp": "^0.31.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
