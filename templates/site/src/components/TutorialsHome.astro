---
import { readdirSync, existsSync } from 'fs';
import { join } from 'path';
import Base from '../layouts/Base.astro';
import VideoCard from './VideoCard.astro';
import VideoModal from './VideoModal.astro';
import tutorials from '../data/tutorials.json';

const { categories, videos, ui } = tutorials as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Scan for step screenshots at build time
const videosDir = join(process.cwd(), 'public/videos');
type StepEntry = { n: number; url: string };
const stepsByVideo: Record<string, string[]> = {};
if (existsSync(videosDir)) {
	const staging: Record<string, StepEntry[]> = {};
	for (const file of readdirSync(videosDir)) {
		const m = file.match(/^(.+)-step-(\d+)\.(png|jpe?g|webp|avif)$/);
		if (!m) continue;
		const [, id, n] = m;
		(staging[id] ??= []).push({ n: parseInt(n), url: `${base}/videos/${file}` });
	}
	for (const [id, entries] of Object.entries(staging)) {
		stepsByVideo[id] = entries.sort((a, b) => a.n - b.n).map(s => s.url);
	}
}

const getSteps = (file: string): string[] => {
	const base = file.replace(/\.[^.]+$/, '');
	return stepsByVideo[base] ?? [];
};

const videosByCategory = videos.reduce((acc: Record<string, any[]>, video: any) => {
	if (!acc[video.category]) acc[video.category] = [];
	acc[video.category].push(video);
	return acc;
}, {} as Record<string, any[]>);

// Variant filter (desktop / mobile / …) — only shown when at least one video
// was recorded in a variant.
const variants: string[] = [...new Set(videos.map((v: any) => v.variant ?? ''))] as string[];
const hasVariants = variants.some((v) => v !== '');
const variantLabel = (v: string) => (v === '' ? 'Desktop' : v.charAt(0).toUpperCase() + v.slice(1));
---

<Base title={ui.heroTitle}>
	<section class="hero">
		<h1>{ui.heroTitle}</h1>
		<p>{ui.heroSubtitle}</p>
	</section>

	{hasVariants && (
		<nav class="variant-filter" aria-label="Filter by variant">
			<button class="variant-btn active" data-variant="all">All</button>
			{variants.sort().map((v) => (
				<button class="variant-btn" data-variant={v}>{variantLabel(v)}</button>
			))}
		</nav>
	)}

	{Object.entries(categories).map(([catId, cat]: [string, any]) => {
		const catVideos = videosByCategory[catId];
		if (!catVideos?.length) return null;
		return (
			<section class="category">
				<div class="category-header">
					<span class="category-icon">{cat.icon}</span>
					<h2>{cat.label}</h2>
				</div>
				<div class="video-grid">
					{catVideos.map((video: any) => (
						<VideoCard
							id={video.id}
							title={video.title}
							duration={video.duration}
							videoUrl={`${base}/videos/${video.file}`}
							steps={getSteps(video.file)}
							href={`${base}/${video.id}`}
							variant={video.variant}
						/>
					))}
				</div>
			</section>
		);
	})}

	<VideoModal />
</Base>

<style>
	.variant-filter {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
	}

	.variant-btn {
		padding: 0.4rem 1rem;
		border: 1px solid var(--color-border, #ddd);
		border-radius: 999px;
		background: transparent;
		color: var(--color-text-muted, #666);
		font-size: 0.9rem;
		cursor: pointer;
		transition: all 0.2s;
	}

	.variant-btn:hover {
		border-color: var(--color-primary, #0066fd);
		color: var(--color-primary, #0066fd);
	}

	.variant-btn.active {
		background: var(--color-primary, #0066fd);
		border-color: var(--color-primary, #0066fd);
		color: white;
	}
</style>

<script>
	const bar = document.querySelector('.variant-filter');
	bar?.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLElement>('.variant-btn');
		if (!btn) return;
		const filter = btn.dataset.variant!;
		bar.querySelectorAll('.variant-btn').forEach((b) => b.classList.toggle('active', b === btn));
		document.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
			const match = filter === 'all' || (card.dataset.variant ?? '') === filter;
			card.style.display = match ? '' : 'none';
		});
		// Hide categories left with no visible card
		document.querySelectorAll<HTMLElement>('section.category').forEach((section) => {
			const anyVisible = [...section.querySelectorAll<HTMLElement>('.video-card')].some(
				(card) => card.style.display !== 'none'
			);
			section.style.display = anyVisible ? '' : 'none';
		});
	});
</script>
