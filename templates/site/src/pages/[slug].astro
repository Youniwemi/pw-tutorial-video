---
import { readdirSync, existsSync } from 'fs';
import { join } from 'path';
import Base from '../layouts/Base.astro';
import tutorials from '../data/tutorials.json';

export function getStaticPaths() {
	const all = (tutorials as any).videos;
	return all.map((v: any, i: number) => ({
		params: { slug: v.id },
		props: { video: v, index: i, allVideos: all },
	}));
}

const { video, index, allVideos } = Astro.props as any;

// Step screenshots
const videosDir = join(process.cwd(), 'public/videos');
type StepEntry = { n: number; url: string };
const steps: string[] = [];
if (existsSync(videosDir)) {
	const base = video.file.replace(/\.[^.]+$/, '');
	const escaped = base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	const pattern = new RegExp(`^${escaped}-step-(\\d+)\\.(png|jpe?g|webp|avif)$`);
	const staging: StepEntry[] = [];
	for (const file of readdirSync(videosDir)) {
		const m = file.match(pattern);
		if (m) staging.push({ n: parseInt(m[1]), url: `/videos/${file}` });
	}
	steps.push(...staging.sort((a, b) => a.n - b.n).map(s => s.url));
}

const poster = steps[0];
const prev = index > 0 ? allVideos[index - 1] : null;
const next = index < allVideos.length - 1 ? allVideos[index + 1] : null;
---

<Base title={video.title}>
	<div class="video-page">
		<a href="/" class="back-link">← All tutorials</a>

		<div class="video-player-wrap">
			<video controls class="video-player" poster={poster}>
				<source src={`/videos/${video.file}`} type="video/webm" />
			</video>
		</div>

		<div class="video-page-info">
			<h1 class="video-page-title">{video.title}</h1>
			<div class="video-page-meta">
				<span class="video-duration">&#x1F553; {video.duration}</span>
			</div>
		</div>

		{steps.length > 0 && (
			<div class="steps-section">
				<div class="step-strip">
					{steps.map((src: string, i: number) => (
						<div class="step-frame">
							<img src={src} alt={`Step ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
							<span class="step-num">{i + 1}</span>
						</div>
					))}
				</div>
			</div>
		)}

		<nav class="video-nav-row" aria-label="navigation">
			<div class="nav-prev">
				{prev && (
					<a href={`/${prev.id}`} class="nav-link nav-link-prev">
						<span class="nav-arrow">‹</span>
						<span class="nav-title">{prev.title}</span>
					</a>
				)}
			</div>
			<div class="nav-next">
				{next && (
					<a href={`/${next.id}`} class="nav-link nav-link-next">
						<span class="nav-title">{next.title}</span>
						<span class="nav-arrow">›</span>
					</a>
				)}
			</div>
		</nav>
	</div>
</Base>

<style>
	.video-page {
		max-width: 900px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--color-primary);
	}

	.video-player-wrap {
		width: 100%;
		border-radius: var(--radius);
		overflow: hidden;
		background: #000;
		box-shadow: var(--shadow);
		margin-bottom: 1.5rem;
	}

	.video-player {
		width: 100%;
		display: block;
		max-height: 70vh;
	}

	.video-page-info {
		margin-bottom: 1.5rem;
	}

	.video-page-title {
		font-size: 1.75rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		line-height: 1.3;
	}

	.video-page-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.video-duration {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.steps-section {
		margin-bottom: 2rem;
	}

	.step-strip {
		display: flex;
		gap: 0.75rem;
		overflow-x: auto;
		padding-bottom: 0.5rem;
	}

	.step-strip::-webkit-scrollbar {
		height: 4px;
	}

	.step-strip::-webkit-scrollbar-track {
		background: var(--color-border);
		border-radius: 2px;
	}

	.step-strip::-webkit-scrollbar-thumb {
		background: var(--color-text-muted);
		border-radius: 2px;
	}

	.step-frame {
		position: relative;
		flex-shrink: 0;
		width: 200px;
		border-radius: 0.5rem;
		overflow: hidden;
		box-shadow: var(--shadow);
	}

	.step-frame img {
		width: 100%;
		height: 113px;
		object-fit: cover;
		display: block;
	}

	.step-num {
		position: absolute;
		top: 6px;
		left: 6px;
		background: rgba(0, 0, 0, 0.65);
		color: white;
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.1rem 0.4rem;
		border-radius: 0.25rem;
	}

	.video-nav-row {
		display: flex;
		justify-content: space-between;
		align-items: stretch;
		gap: 1rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
		margin-top: 1rem;
	}

	.nav-prev,
	.nav-next {
		flex: 1;
	}

	.nav-next {
		text-align: right;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--color-text);
		padding: 0.75rem 1rem;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: var(--color-bg-card);
		transition: all 0.2s;
		font-size: 0.9rem;
		max-width: 100%;
	}

	.nav-link:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		box-shadow: var(--shadow);
	}

	.nav-link-next {
		flex-direction: row-reverse;
	}

	.nav-arrow {
		font-size: 1.25rem;
		line-height: 1;
		flex-shrink: 0;
		color: var(--color-primary);
	}

	.nav-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 600px) {
		.video-page-title {
			font-size: 1.25rem;
		}

		.step-frame {
			width: 150px;
		}

		.step-frame img {
			height: 85px;
		}

		.nav-title {
			display: none;
		}
	}
</style>
