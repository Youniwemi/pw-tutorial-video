---
import '../styles/tutorials.css';
import siteConfig from '../data/site-config.json';

interface Props {
	title: string;
	description?: string;
}

const config = siteConfig as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description = config.title } = Astro.props;

const cssVars = [
	config.primaryColor && `--color-primary: ${config.primaryColor}`,
	config.font && `--font-family: ${config.font}`,
]
	.filter(Boolean)
	.join('; ');
---

<!doctype html>
<html lang={config.lang || 'en'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title} | {config.title}</title>
	</head>
	<body style={cssVars || undefined}>
		<header>
			<div class="header-content">
				<a href={`${base}/`} class="logo">
					{
						config.logo ? (
							<img src={config.logo} alt={config.title} class="logo-img" />
						) : (
							<span class="logo-icon">🎬</span>
						)
					}
					<span class="logo-text">{config.title}</span>
				</a>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-content">
				<span>© {new Date().getFullYear()} {config.title}</span>
				<span>·</span>
				<span>Built with pw-tutorial-video</span>
			</div>
		</footer>
	</body>
</html>
